{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource holding Tempo span-metrics for messfit-api",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "MessFit — AI / Optimizer",
  "uid": "messfit-ai-optimizer",
  "tags": ["messfit", "ai", "optimizer", "llm"],
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      { "name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "current": {} }
    ]
  },
  "panels": [
    {
      "title": "Optimizer solve time — p50 / p95 / p99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Derived from the optimizer.solve span duration (Tempo span-metrics).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(traces_spanmetrics_latency_bucket{span_name=\"optimizer.solve\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{span_name=\"optimizer.solve\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_spanmetrics_latency_bucket{span_name=\"optimizer.solve\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "Optimizer infeasibility rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Share of optimizer.solve spans whose solver_status attribute is not Optimal. Requires the Tempo metrics-generator to map the optimizer.solver_status span attribute to a label.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traces_spanmetrics_calls_total{span_name=\"optimizer.solve\", solver_status!=\"Optimal\"}[5m])) / clamp_min(sum(rate(traces_spanmetrics_calls_total{span_name=\"optimizer.solve\"}[5m])), 1)",
          "legendFormat": "infeasible %"
        }
      ]
    },
    {
      "title": "Chatbot generation latency p95 (first-token proxy)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "p95 of the chat.generate span; chat.first_token_ms is recorded as a span attribute and surfaced in traces.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{span_name=\"chat.generate\"}[5m])))",
          "legendFormat": "chat.generate p95"
        }
      ]
    },
    {
      "title": "Retrieval calls / s",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traces_spanmetrics_calls_total{span_name=\"chat.retrieve\"}[5m]))",
          "legendFormat": "chat.retrieve"
        }
      ]
    },
    {
      "title": "LLM tokens / request + cost / day (₹) — placeholder",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Token usage and cost are not yet emitted as metrics. Wire a counter (e.g. llm_tokens_total{kind=\"input|output\"}) from chatbot/llm.py and a recording rule that multiplies by the per-token rate to populate this panel.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(llm_tokens_total[1d]))",
          "legendFormat": "tokens/day (emit me)"
        }
      ]
    }
  ]
}
