{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "Postgres (MessFit DB)",
      "description": "Read-only Postgres datasource pointed at the MessFit database",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    },
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource holding Tempo span-metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "MessFit — Business",
  "uid": "messfit-business",
  "tags": ["messfit", "business", "kpi"],
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-30d", "to": "now" },
  "refresh": "5m",
  "templating": {
    "list": [
      { "name": "DS_POSTGRES", "type": "datasource", "query": "postgres", "current": {} },
      { "name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "current": {} }
    ]
  },
  "panels": [
    {
      "title": "DAU (distinct users who logged anything today)",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT count(DISTINCT user_id) AS dau FROM meal_logs WHERE date = (now() AT TIME ZONE 'Asia/Kolkata')::date;",
          "format": "table"
        }
      ]
    },
    {
      "title": "WAU (distinct users active in last 7 days)",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT count(DISTINCT user_id) AS wau FROM meal_logs WHERE date >= ((now() AT TIME ZONE 'Asia/Kolkata')::date - INTERVAL '7 days');",
          "format": "table"
        }
      ]
    },
    {
      "title": "Total users",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT count(*) AS users FROM users WHERE deleted_at IS NULL;",
          "format": "table"
        }
      ]
    },
    {
      "title": "Signups / day",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT date_trunc('day', created_at) AS time, count(*) AS signups FROM users GROUP BY 1 ORDER BY 1;",
          "format": "time_series"
        }
      ]
    },
    {
      "title": "Daily meal logs / active user",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT date AS time, count(*)::float / NULLIF(count(DISTINCT user_id), 0) AS logs_per_user FROM meal_logs GROUP BY 1 ORDER BY 1;",
          "format": "time_series"
        }
      ]
    },
    {
      "title": "Optimizations / day (from optimizer.solve spans)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(traces_spanmetrics_calls_total{span_name=\"optimizer.solve\"}[1d]))",
          "legendFormat": "optimizations/day"
        }
      ]
    },
    {
      "title": "7-day adherence rate (rolling) — placeholder",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "description": "Adherence is computed in tracking/metrics.py. This panel mirrors that logic in SQL once a daily adherence rollup table/view exists; until then it is a documented stub.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "rawSql": "-- TODO: back with a daily adherence rollup (see tracking/metrics.compute_adherence)\nSELECT now() AS time, 0.0 AS adherence_7d;",
          "format": "time_series"
        }
      ]
    }
  ]
}
