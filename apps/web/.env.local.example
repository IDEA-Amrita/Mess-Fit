NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Canonical site URL (used for SEO metadata / Open Graph). Defaults to messfit.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Environment label sent to Sentry (development | staging | production)
NEXT_PUBLIC_ENV=development

# ── Sentry (Phase 9). All optional — empty = no-op, build still works. ──
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload at build time (CI only — leave blank locally)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=