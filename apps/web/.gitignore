# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next-pwa build output. `public/sw.js` itself stays tracked — it's also the
# hand-written fallback `next dev` serves (workbox only generates a real
# service worker during `next build --webpack`; see next.config.ts) — but
# these content-hashed files are pure build artifacts, different on every
# build, and public/sw.js.map/sw.js get regenerated too (sw.js's tracked
# content is restored by `git checkout` after a local production build).
/public/workbox-*.js
/public/workbox-*.js.map
/public/worker-*.js
/public/worker-*.js.map
/public/sw.js.map
